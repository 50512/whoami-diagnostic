---
import MainLayout from "../layouts/MainLayout.astro";
import { LabToggle } from "@50512/ui/inputs";
import RawCard from "../components/RawCard.astro";
import InfoLine from "../components/InfoLine.astro";
---

<script src="/env.js" is:inline defer></script>
<MainLayout>
  <div class="title">
    <h1>Diagnostic</h1>
    <span>
      <LabToggle
        label="RAW"
        label_pos="left"
        variant="accent"
        id="view-switch"
      />
    </span>
  </div>

  <div class="main-view" id="main-tab">
    <div class="header">
      <h2 id="ip-h2">Cargando IP...</h2>
      <h3 id="ip-h3" class="hidden">
        Cargando IP...
      </h3>
    </div>

    <!-- IP INFO -->
    <div class="info-container">
      <h2 class="info-title">IP info</h2>
      <InfoLine name="ASN" id="asn-block" class="ip-info-block" />
      <InfoLine name="CIDR" id="cidr-block" class="ip-info-block" />
      <InfoLine name="GEO" id="geo-block" class="ip-info-block" />
      <InfoLine name="LOCATION" id="loc-block" class="ip-info-block" />
      <InfoLine name="TIMEZONE" id="tz-block" class="ip-info-block" />
      <InfoLine name="ZIP CODE" id="zip-block" class="ip-info-block" />
    </div>

    <!-- RDAP INFO -->
    <div class="info-container">
      <h2 class="info-title">RDAP info</h2>
      <InfoLine
        name="REGISTRANT"
        id="registrant-block"
        class="rdap-info-block"
      />
      <InfoLine name="RDAP NET" id="rdap-net-block" class="rdap-info-block" />
    </div>

    <!-- CLIENT INFO -->
    <div class="info-container client">
      <h2 class="info-title">Client headers</h2>
      <InfoLine name="USER-AGENT" id="ua-block" class="client-info-block" />
      <InfoLine name="LANGUAGE" id="language-block" class="client-info-block" />
      <InfoLine
        name="CLIENT-HINT UA"
        id="sec-ch-ua-block"
        class="client-info-block"
      />
      <InfoLine
        name="PLATFORM"
        id="sec-ch-ua-platform-block"
        class="client-info-block"
      />
    </div>

    <!-- DNS LEAK -->
    <div class="info-container client">
      <h2 class="info-title">DNS</h2>
      <InfoLine
        name="RESOLVERS"
        id="resolvers-block"
        class="multi-line dns-info-block"
      />
      <InfoLine name="ECS" id="ecs-block" class="multi-line dns-info-block" />
    </div>

    <!-- METRICS -->
    <div class="info-container client">
      <h2 class="info-title">Metrics</h2>
      <InfoLine name="RTT" id="rtt-block" class="rtt-info-block" />
    </div>

    <!-- CARD FOOTER -->
    <div>
      <small class="footer micro" id="metadata"></small>
      <small class="footer" id="attributions"></small>
    </div>
  </div>

  <div class="raw-view" id="raw-tab">
    <RawCard title="/ip/detail" id="raw-ip-detail" collapse_depth={3} />
    <RawCard
      title="/client/headers"
      id="raw-client-headers"
      collapse_depth={3}
    />
    <RawCard title="/dns-leak/{token}" id="raw-dns-leak" collapse_depth={2} />
    <RawCard title="/info" id="raw-metadata" />
    <RawCard
      title="RDAP-Registrant"
      id="raw-registrant-rdap"
      collapse_depth={3}
    />
    <RawCard title="Raw RDAP" id="raw-rdap" collapse_depth={3} />
  </div>
</MainLayout>

<!-- SWITCH VIEWS -->
<script>
  document.addEventListener("astro:page-load", () => {
    const switchTab = document.getElementById(
      "view-switch",
    ) as HTMLInputElement;
    if (!switchTab) return;

    const updateHash = () => {
      const hash = window.location.hash.substring(1).toLowerCase();
      const cleanUrl = window.location.pathname + window.location.search;

      if (hash === "raw") history.replaceState(null, "", cleanUrl);
      else history.replaceState(null, "", "#raw");
    };

    const readHash = () => {
      const hash = window.location.hash.substring(1).toLowerCase();
      switchTab.checked = hash === "raw";
    };

    readHash();
    switchTab.addEventListener("input", () => {
      updateHash();
    });
  });
</script>

<script>
  import { loadIPInfo } from "../scripts/ip";
  import { loadDNSLeak } from "../scripts/dnsLeak";
  import { loadClientHeaders } from "../scripts/client";
  import { loadMetadata, loadAttributions } from "../scripts/meta";
  import { loadRDAPInfo } from "../scripts/rdap";
  import { measureRealtimeEndpoint, renderMetrics } from "../scripts/metrics";

  document.addEventListener("astro:page-load", loadAll);

  /**
   * Ejecuta toda la lógica de consulta y medición
   */
  async function loadAll() {
    // Inicia en paralelo todas las peticiones
    loadMetadata();
    const ipPromise = loadIPInfo();
    const leakPromise = loadDNSLeak();
    const headersPromise = loadClientHeaders();
    const realtimePromise = measureRealtimeEndpoint();

    const { ipv4, ipv6 } = await ipPromise;

    // Requiere resultado de IP, por lo que se inicializa después
    loadRDAPInfo({
      ipv4: ipv4.data,
      ipv6: ipv6.data,
    });

    const headers = await headersPromise;
    const realtimeRTT = await realtimePromise;

    renderMetrics({
      ipv4: ipv4.rtt,
      ipv6: ipv6.rtt,
      realtime: realtimeRTT,
      host: headers.rtt,
    });
    const leak = await leakPromise;

    loadAttributions({
      ipv4: ipv4.data,
      ipv6: ipv6.data,
      leak,
    });
  }
</script>

<style>
  .title {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    h1 {
      white-space: nowrap;
      border: var(--border-soft);
      background: var(--surface-1);
      box-shadow: var(--shadow-label-orange);
      width: fit-content;
      padding: var(--space-1);
      position: absolute;
      top: -50px;
    }
    span {
      position: absolute;
      right: var(--space-1);
    }
  }

  .title:has(#view-switch:checked) {
    & ~ div#main-tab {
      display: none;
    }

    & ~ div#raw-tab {
      display: flex;
    }
  }

  .header {
    border-bottom: var(--border-dashed);
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  #ip-h3,
  #ip-h2 {
    text-align: center;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  .info-title {
    width: fit-content;
    padding: var(--space-1);
    margin-bottom: var(--space-1);
    border: var(--border-soft);
    box-shadow: var(--shadow-label-gray);
  }

  :global(.location-link) {
    font-style: italic;
    color: var(--ink-2);
    text-decoration-style: dashed;
  }

  .raw-view {
    display: none;
    flex-direction: column;
    gap: var(--space-4);
  }

  .info-container.client {
    margin: var(--space-1) 0;
  }

  #attributions {
    flex-direction: column;
  }

  #metadata {
    gap: 1ch;
    text-wrap: balance;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    font-size: var(--fs-micro);
    font-style: italic;
    line-height: var(--lh-micro);
    a {
      color: var(--ink-2);
    }
  }

  .hidden {
    display: none;
  }
</style>
