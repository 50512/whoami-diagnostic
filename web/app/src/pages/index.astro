---
import MainLayout from "../layouts/MainLayout.astro";
import { LabToggle } from "@50512/ui/inputs";
import RawCard from "../components/RawCard.astro";
import InfoLine from "../components/InfoLine.astro";
---

<script src="/env.js" is:inline defer></script>
<MainLayout>
  <div class="title">
    <h1>IP Diagnostic</h1>
    <span>
      <LabToggle
        label="RAW"
        label_pos="left"
        variant="accent"
        id="view-switch"
      />
    </span>
  </div>

  <div class="main-view" id="main-tab">
    <div class="header">
      <h2 id="ip-h2">Cargando IP...</h2>
      <h3 id="ip-h3" class="hidden">
        Cargando IP...
      </h3>
    </div>
    <div>
      <h2 class="info-title">IP info</h2>
      <InfoLine name="ASN" id="asn-block" class="ip-info-block" />
      <InfoLine name="CIDR" id="cidr-block" class="ip-info-block" />
      <InfoLine name="GEO" id="geo-block" class="ip-info-block" />
      <InfoLine name="LOCATION" id="loc-block" class="ip-info-block" />
      <InfoLine name="ZIP CODE" id="zip-block" class="ip-info-block" />
    </div>
    <div>
      <h2 class="info-title">RDAP info</h2>
      <InfoLine
        name="REGISTRANT"
        id="registrant-block"
        class="rdap-info-block"
      />
      <InfoLine name="RDAP NET" id="rdap-net-block" class="rdap-info-block" />
    </div>
    <div>
      <small class="footer" id="metadata"></small>
      <small class="footer" id="attributions"></small>
    </div>
  </div>

  <div class="raw-view hidden" id="raw-tab">
    <RawCard title="/ip/detail" id="raw-ip-detail" collapse_depth={3} />
    <RawCard
      title="/client/headers"
      id="raw-client-headers"
      collapse_depth={3}
    />
    <RawCard title="/dns-leak/{token}" id="raw-dns-leak" collapse_depth={2} />
    <RawCard title="/info" id="raw-metadata" />
    <RawCard
      title="RDAP-Registrant"
      id="raw-registrant-rdap"
      collapse_depth={3}
    />
    <RawCard title="Raw RDAP" id="raw-rdap" collapse_depth={3} />
  </div>
</MainLayout>

<!-- SWITCH VIEWS -->
<script>
  document.addEventListener("astro:page-load", () => {
    const mainTab = document.getElementById("main-tab");
    const rawTab = document.getElementById("raw-tab");
    const switchTab = document.getElementById(
      "view-switch",
    ) as HTMLInputElement;
    if (!mainTab || !rawTab || !switchTab) return;

    const updateView = () => {
      if (switchTab.checked) {
        mainTab.classList.add("hidden");
        rawTab.classList.remove("hidden");
      } else {
        mainTab.classList.remove("hidden");
        rawTab.classList.add("hidden");
      }
    };

    updateView();
    switchTab.addEventListener("input", () => {
      updateView();
    });
  });
</script>

<script>
  import type { JsonViewElement } from "@50512/ui/json";

  const HARD_TIMEOUT_MS = 8000;
  const GRACE_MS = 1500;
  const IP_VERSIONS = ["ipv4", "ipv6"] as const;
  type IPVersion = (typeof IP_VERSIONS)[number];

  /** Estructura de información de geolocation por MaxMind */
  interface IPGeolocation {
    country: {
      name: string | null;
      iso_code: string | null;
    };
    region: string | null;
    city: string | null;
    continent_code: string | null;
    zip_code: string | null;
  }

  /** Estructura de coordenadas y radio de precisión para location por MaxMind */
  interface Location {
    latitude: number | null;
    longitude: number | null;
    accuracy_radius: number | null;
    timezone: string | null;
  }

  /** Estructura de atribuciones para cumplir con los ToS de algunas DB */
  interface Attributions {
    source: string;
    text: string;
    url: string;
  }

  /** Estructura de información de los resolvers detectados por DNS leak */
  interface ResolverInfo {
    asns: Array<number> | null;
    asns_org: Array<string> | null;
    ips: Array<string> | null;
    cidrs: Array<string> | null;
  }

  /** Estructura de información de la API de DNS leak */
  interface DNSLeak {
    test_id: string;
    count: number;
    resolvers: Record<string, ResolverInfo>;
    attributions: Record<string, Attributions> | null;
  }

  /** Estructura de información detallada de IP */
  interface IPDetail {
    ip: string;
    asn: number | null;
    asn_org: string | null;
    cidr: string | null;
    geolocation: IPGeolocation;
    location: Location;
    attributions: Record<string, Attributions> | null;
    rdap_url: string | null;
  }

  /** Estructura de resultado de fetch a cabeceras del cliente (headers + RTT) */
  interface HeadersFetchResult {
    headers: Record<string, string> | null;
    rtt: number | null;
  }

  /** Estructura de resultado de fetch a detalle de una IP (data + RTT) */
  interface IPFetchResult {
    data: IPDetail | null;
    rtt: number | null;
  }

  /** Estructura de información de RDAP (solo datos utilizados en el script) */
  interface RDAPInfo {
    registrant: string | null;
    network: string | null;
  }

  /** Estructura del objeto Cidr0 de RDAP */
  interface RDAPCidr0 {
    v4prefix?: string;
    v6prefix?: string;
    length: number;
  }

  /** Estructura de entidad RDAP */
  interface RDAPEntity {
    handle: string | null;
    roles: Array<string>;
    vcardArray: {
      0: "vcard";
      1: Array<Array<string | Object | Array<string>>>;
    } | null;
  }

  /** Estructura de respuesta de RDAP acotado al uso del script */
  interface RDAPResponse {
    name: string | null;
    cidr0_cidrs: Array<RDAPCidr0> | null;
    startAddress: string;
    endAddress: string;
    handle: string | null;
    entities: Array<RDAPEntity> | null;
  }

  /** Resultados de peticiones hacia RDAP */
  interface RDAPFetchResults {
    data: RDAPResponse | null;
    url: string | null;
  }

  /** Interfaz de `/info` de la API */
  interface MetaAPI {
    status: string;
    asn_last_update: string;
    city_last_update: string;
  }

  // --------- DATA EXTRACTION --------

  /**
   * Mide el _Round Trip Time_ de una petición efectuada a la URL ingresada
   */
  function measureRTT(url: string): number | null {
    const absoluteUrl = new URL(url, window.location.origin).href;

    const entries = performance.getEntriesByName(
      absoluteUrl,
      "resource",
    ) as PerformanceResourceTiming[];
    const metric = entries[entries.length - 1];

    if (!metric) return null;

    if (metric.responseStart > 0 && metric.requestStart > 0)
      return Math.round(metric.responseStart - metric.requestStart);

    return null;
  }

  /**
   * Obtiene la metadata de la API (estado y última actualización)
   */
  async function getMetaAPI(): Promise<MetaAPI | null> {
    let results: MetaAPI | null = null;

    try {
      const res = await fetch("/info");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      results = (await res.json()) as MetaAPI;
    } catch (error) {}

    return results;
  }

  /**
   * Regresa el objeto de resultados para las peticiones detalladas de IPv4 e IPv6 con la medida RTT
   */
  async function fetchIPDetails(): Promise<Record<IPVersion, IPFetchResult>> {
    const results: Record<IPVersion, IPFetchResult> = {
      ipv4: {
        data: null,
        rtt: null,
      },
      ipv6: {
        data: null,
        rtt: null,
      },
    };

    const FETCH_URLS = {
      ipv4: `https://${window.__ENV__.IPV4_HOST}/ip/detail`,
      ipv6: `https://${window.__ENV__.IPV6_HOST}/ip/detail`,
    };

    const grace = new AbortController();
    let graceTimer: number | undefined;

    await Promise.all(
      IP_VERSIONS.map(async (version) => {
        const url = FETCH_URLS[version];
        const signal = AbortSignal.any([
          grace.signal,
          AbortSignal.timeout(HARD_TIMEOUT_MS),
        ]);

        try {
          const res = await fetch(url, { signal });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);

          const data = (await res.json()) as IPDetail;
          const rtt = measureRTT(url);

          results[version] = { data, rtt };
          graceTimer ??= window.setTimeout(() => grace.abort(), GRACE_MS);
        } catch (err) {
          console.error(`Error al obtener ${version}`, err);
        }
      }),
    );

    return results;
  }

  /**
   * Ejecuta las peticiones al UUID en la zona de leak DNS y luego consulta
   * al endpoint del leak la información de los resolvers que consultaron el
   * UUID
   */
  async function getDNSLeak(): Promise<DNSLeak | null> {
    const test_id = crypto.randomUUID().replaceAll("-", "");
    const requests = [];
    let results: DNSLeak | null = null;

    for (let i = 0; i < 10; i++) {
      const url = `https://${i}.${test_id}.${window.__ENV__.LEAK_ZONE}`;
      requests.push(
        fetch(url, {
          mode: "no-cors",
        }).catch(() => {}),
      );
    }

    await Promise.allSettled(requests);

    try {
      const res = await fetch(`/dns-leak/${test_id}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      results = (await res.json()) as DNSLeak;
    } catch (err) {
      console.error(`Error al obtener los resultados: ${err}`);
    }

    return results;
  }

  /**
   * Devuelve las cabeceras recibidas por el servidor con la medida RTT
   * por el host actual/principal
   */
  async function getClientHeaders(): Promise<HeadersFetchResult> {
    const results: HeadersFetchResult = {
      headers: null,
      rtt: null,
    };

    const url = "/client/headers";

    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      results.headers = (await res.json())["headers"];
      results.rtt = measureRTT(url);
    } catch (error) {}

    return results;
  }

  /**
   * Recibe un objeto que contenga información `IPDetail` o `DNSLeak` y
   * devuelve sus atribuciones únicas (para cumplimiento de ToS de algunas fuentes)
   */
  function readAttributions(
    data: Record<IPVersion | string, IPDetail | DNSLeak | null>,
  ): Record<string, Attributions> | null {
    const attributions: Record<string, Attributions> | null = {};

    Object.values(data).map((value) => {
      if (!value || !value.attributions) return;
      const attr_value = value.attributions;
      Object.keys(attr_value).map((key) => {
        if (!attr_value[key]) return;
        attributions[key] = attr_value[key];
      });
    });

    return attributions;
  }

  /**
   * Extrae el `registrant` de la respuesta RDAP. No se garantiza funcionalidad total.
   */
  function extractRDAPRegistrant(info: RDAPResponse): string | null {
    let registrant = null;

    if (!info.entities || !Array.isArray(info.entities)) return null;

    const relevantEntity = info.entities.find(
      (e) => e.roles && e.roles.includes("registrant"),
    );

    if (relevantEntity && relevantEntity.vcardArray) {
      const attributes = relevantEntity.vcardArray[1];
      const attrName = attributes.find((attr) => attr[0] == "fn");

      if (attrName && attrName[3]) registrant = (attrName[3] as string).trim();
    }

    return registrant;
  }

  /**
   * Obtiene el bloque de red desde RDAP
   */
  function extractRDAPNetwork(info: RDAPResponse): string | null {
    let network = null;
    // Apostar por bloque existente
    if (info.cidr0_cidrs && info.cidr0_cidrs.length > 0) {
      const block = info.cidr0_cidrs[0];
      const ipBase = block.v4prefix || block.v6prefix;
      if (ipBase && block.length) return `${ipBase}/${block.length}`;
    }

    // Fallback
    const cidrRegex = /([0-9a-f:\.]+)\/([0-9]{1,3})/i;
    if (info.handle && cidrRegex.test(info.handle)) {
      let match = info.handle.match(cidrRegex);
      if (match) return match[0];
    }
    if (info.name && cidrRegex.test(info.name)) {
      let match = info.name.match(cidrRegex);
      if (match) return match[0];
    }

    if (info.startAddress && info.endAddress)
      return `${info.startAddress} - ${info.endAddress}`;

    return network;
  }

  /**
   * Extrae de la respuesta original el RDAP Net y RDAP Registrant
   */
  function extractRDAP(
    rdapRaw: Record<IPVersion, RDAPFetchResults>,
  ): Record<IPVersion, RDAPInfo> {
    const results: Record<IPVersion, RDAPInfo> = {
      ipv4: {
        registrant: null,
        network: null,
      },
      ipv6: {
        registrant: null,
        network: null,
      },
    };

    IP_VERSIONS.map(async (version) => {
      const currentVersion = rdapRaw[version];
      if (!currentVersion || !currentVersion.data) return;
      try {
        results[version].registrant = extractRDAPRegistrant(
          currentVersion.data,
        );
        results[version].network = extractRDAPNetwork(currentVersion.data);
      } catch (err) {
        console.error(`No se pudo obtener RDAP de ${version}: ${err}`);
      }
    });

    return results;
  }

  /**
   * Regresa el RDAP completo de las IPs
   */
  async function getRDAPinfo(
    data: Record<IPVersion, IPDetail | null>,
  ): Promise<Record<IPVersion, RDAPFetchResults>> {
    const results: Record<IPVersion, RDAPFetchResults> = {
      ipv4: { data: null, url: null },
      ipv6: { data: null, url: null },
    };
    await Promise.all(
      IP_VERSIONS.map(async (version) => {
        const currentVersion = data[version];
        if (!currentVersion || !currentVersion.rdap_url) return;
        const url = currentVersion.rdap_url;

        try {
          const res = await fetch(url);
          results[version].url = url;
          if (!res.ok) throw new Error(`HTTP ${res.status}`);

          results[version].data = (await res.json()) as RDAPResponse;
        } catch (err) {
          console.error(`No se pudo obtener RDAP de ${version}: ${err}`);
        }
      }),
    );
    return results;
  }

  document.addEventListener("astro:page-load", load_all);

  /**
   * Ejecuta toda la lógica de consulta y medición
   */
  async function load_all() {
    // Inicia en paralelo todas las peticiones
    const ipPromise = fetchIPDetails();
    const headersPromise = getClientHeaders();
    const leakPromise = getDNSLeak();
    const metadataPromise = getMetaAPI();

    const { ipv4, ipv6 } = await ipPromise;

    render_ip_header({ ipv4, ipv6 });
    render_ip_info({ ipv4, ipv6 });

    // Requiere resultado de IP, por lo que se inicializa después
    const rdapPromise = getRDAPinfo({
      ipv4: ipv4.data,
      ipv6: ipv6.data,
    });

    const [headers, leak, rdapRaw, metadata] = await Promise.all([
      headersPromise,
      leakPromise,
      rdapPromise,
      metadataPromise,
    ]);
    const attributions = readAttributions({
      ipv4: ipv4.data,
      ipv6: ipv6.data,
      leak,
    });

    if (attributions) render_attributions(attributions);
    if (metadata) render_metadata(metadata);
    render_rdap(rdapRaw);
    render_raw(headers, leak);
  }

  // --------- RENDER ---------

  /**
   * Plantilla de bloques de IP info simples
   */
  const propertyTemplatesIP: Record<string, (data: IPDetail) => string> = {
    "asn-block": (data) => `AS${data.asn ?? "-"} - ${data.asn_org ?? ""}`,
    "cidr-block": (data) => data.cidr ?? "-",
    "geo-block": (data) =>
      `${data.geolocation.country.name ?? "-"}/${data.geolocation.region ?? "-"}/${data.geolocation.city ?? "-"}`,
    "zip-block": (data) => data.geolocation.zip_code ?? "-",
  };

  /**
   * Plantilla de bloques de IP info simples
   */
  const propertyTemplatesRDAP: Record<string, (data: RDAPInfo) => string> = {
    "registrant-block": (data) => data.registrant ?? "-",
    "rdap-net-block": (data) => data.network ?? "-",
  };

  /**
   * Escribe las IP a la cabecera de la vista principal
   */
  function render_ip_header(data: Record<IPVersion, IPFetchResult>) {
    const mainIP = document.getElementById("ip-h2");
    const secondIP = document.getElementById("ip-h3");
    const { ipv4, ipv6 } = data;

    if (!mainIP || !secondIP) return;
    // Si no hay IPv4, se pone IPv6 en principal
    if (ipv4.data) mainIP.textContent = ipv4.data.ip;
    else if (ipv6.data) mainIP.textContent = ipv6.data.ip;

    // Si hay IPv4 e IPv6, pone la IPv6 en la 2da linea
    if (ipv6.data && ipv4.data) {
      secondIP.textContent = ipv6.data.ip;
      secondIP.classList.remove("hidden");
    }
  }

  /**
   * Escribe toda la info de IP
   */
  function render_ip_info(data: Record<IPVersion, IPFetchResult>) {
    const rawElement = document.getElementById(
      "raw-ip-detail",
    ) as JsonViewElement | null;
    if (rawElement) rawElement.data = data;

    document
      .querySelectorAll(".ip-info-block>.placeholder")
      .forEach((ele) => ele.classList.add("hidden"));

    IP_VERSIONS.forEach((version) => {
      const currentDetail = data[version].data;

      // Solo muestra la versión si esta disponible
      if (!currentDetail) return;
      document
        .querySelectorAll(`.ip-info-block>.${version}`)
        .forEach((ele) => ele.classList.remove("hidden"));

      // Ejecuta las templates en cada bloque
      Object.entries(propertyTemplatesIP).forEach(([id, formatter]) => {
        const target = document.querySelector(
          `#${id}>.${version}>.block-content`,
        ) as HTMLSpanElement | null;
        if (target) target.textContent = formatter(currentDetail);
      });

      render_location(currentDetail, version);
    });
  }

  /**
   * Escribe los enlaces posición en su bloque
   */
  function render_location(data: IPDetail, version: IPVersion) {
    const { latitude, longitude, accuracy_radius } = data.location;
    const locationElement = document.querySelector(
      `#loc-block>.${version}>.block-content`,
    ) as HTMLSpanElement | null;

    if (!locationElement) return;
    if (latitude == null || longitude == null)
      return locationElement.replaceChildren("-");

    const url = genLinkOSM(latitude, longitude, accuracy_radius);

    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.target = "_blank";
    anchor.textContent = `${latitude}, ${longitude} ±${accuracy_radius ?? 50}Km`;
    anchor.classList.add("location-link");

    locationElement.replaceChildren(anchor);
  }

  /**
   * Escribe la data de RDAP
   */
  function render_rdap(rdap: Record<IPVersion, RDAPFetchResults>) {
    const rawElement = document.getElementById(
      "raw-rdap",
    ) as JsonViewElement | null;
    const rawInfoElement = document.getElementById(
      "raw-registrant-rdap",
    ) as JsonViewElement | null;

    const rdapInfo = extractRDAP(rdap);
    if (rawElement) rawElement.data = rdap;
    if (rawInfoElement) rawInfoElement.data = rdapInfo;

    document
      .querySelectorAll(".rdap-info-block>.placeholder")
      .forEach((ele) => ele.classList.add("hidden"));

    IP_VERSIONS.forEach((version) => {
      const currentDetail = rdapInfo[version];

      document
        .querySelectorAll(`.rdap-info-block>.${version}`)
        .forEach((ele) => ele.classList.remove("hidden"));

      // Ejecuta las templates en cada bloque
      Object.entries(propertyTemplatesRDAP).forEach(([id, formatter]) => {
        const target = document.querySelector(
          `#${id}>.${version}>.block-content`,
        ) as HTMLSpanElement | null;
        if (target) target.textContent = formatter(currentDetail);
      });
    });
  }

  /**
   * Escribe el small inferior de metadata
   */
  function render_metadata(data: MetaAPI) {
    const rawElement = document.getElementById(
      "raw-metadata",
    ) as JsonViewElement | null;

    if (rawElement) rawElement.data = data;

    const metaEle = document.getElementById("metadata");
    if (!metaEle) return;

    const ele = document.createElement("span");
    ele.textContent = "Datos: ";

    Object.entries(data).forEach(([k, v]) => {
      if (k == "status") return;

      const name = k.split("_")[0].toUpperCase();
      const date = new Date(v);

      const year = date.getUTCFullYear();
      const month = String(date.getUTCMonth() + 1).padStart(2, "0");
      const day = String(date.getUTCDate()).padStart(2, "0");

      ele.textContent += `${name}-${year}.${month}.${day} `;
      ele.classList.add("micro");
    });

    metaEle.replaceChildren(ele);
  }

  /**
   * Escribe el small inferior de atribuciones
   */
  function render_attributions(attributions: Record<string, Attributions>) {
    const attrEle = document.getElementById("attributions");
    if (!attrEle) return;
    const lines: Array<HTMLAnchorElement> = [];
    Object.values(attributions).forEach((v) => {
      const anchor = document.createElement("a");

      anchor.href = v.url;
      anchor.textContent = v.text;
      anchor.target = "_blank";

      lines.push(anchor);
    });

    attrEle.replaceChildren(...lines);
  }

  /**
   * Genera el enlace para OpenStreetMap con los parámetros definidos
   */
  function genLinkOSM(
    latitude: number,
    longitude: number,
    accuracy_radius: number | null,
  ): string {
    const radius = accuracy_radius ?? 50;
    const params = new URLSearchParams({
      geouri: `geo:${latitude},${longitude};u=${radius * 1000}`,
    });
    return `https://www.openstreetmap.org/?${params}`;
  }

  /**
   * Carga los JSON a la vista cruda
   */
  function render_raw(headers: HeadersFetchResult, leak: DNSLeak | null) {
    const clientHeaders = document.getElementById(
      "raw-client-headers",
    ) as JsonViewElement | null;

    const dnsLeakElement = document.getElementById(
      "raw-dns-leak",
    ) as JsonViewElement | null;

    if (!clientHeaders || !dnsLeakElement) return;

    clientHeaders.data = headers;
    dnsLeakElement.data = leak;
  }
</script>

<style>
  .title {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    h1 {
      white-space: nowrap;
      border: var(--border-soft);
      background: var(--surface-1);
      box-shadow: var(--shadow-label-orange);
      width: fit-content;
      padding: var(--space-1);
      position: absolute;
      top: -50px;
    }
    span {
      position: absolute;
      right: var(--space-1);
    }
  }

  .header {
    border-bottom: var(--border-dashed);
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  #ip-h3,
  #ip-h2 {
    text-align: center;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  .info-title {
    width: fit-content;
    padding: var(--space-1);
    border-bottom: var(--border-soft);
    border-left: var(--border-soft);
    box-shadow: var(--shadow-recess);
  }

  :global(.location-link) {
    font-style: italic;
    color: var(--ink-2);
    text-decoration-style: dashed;
  }

  .raw-view {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  #attributions {
    flex-direction: column;
  }

  #metadata {
    gap: 1ch;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    font-size: var(--fs-micro);
    font-style: italic;
    line-height: var(--lh-micro);
    a {
      color: var(--ink-2);
    }
  }

  .hidden {
    display: none;
  }
</style>
