---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <div class="title">
    <h1>IP Diagnostic</h1>
  </div>
  <div class="header">
    <h2 id="ip-h2">Cargando IP...</h2>
    <h3 id="ip-h3" class="hidden">
      Cargando IP...
    </h3>
  </div>
</MainLayout>

<script>
  const IP_VERSIONS = ["ipv4", "ipv6"] as const;
  type IPVersion = (typeof IP_VERSIONS)[number];

  interface IPGeolocation {
    country: {
      name: string | null;
      iso_code: string | null;
    };
    region: string | null;
    city: string | null;
    continent_code: string | null;
    zip_code: string | null;
  }

  interface Location {
    latitude: number | null;
    longitude: number | null;
    accuracy_radius: number | null;
    timezone: string | null;
  }

  interface Attributions {
    source: string;
    text: string;
    url: string;
  }

  interface ResolverInfo {
    asn: number | null;
    asn_org: string | null;
    ips: Array<string> | null;
    cidrs: Array<string> | null;
  }

  interface DNSLeak {
    test_id: string;
    count: number;
    resolvers: Record<string, ResolverInfo>;
    attributions: Record<string, Attributions> | null;
  }

  interface IPDetail {
    ip: string;
    asn: number | null;
    asn_org: string | null;
    cidr: string | null;
    geolocation: IPGeolocation | null;
    location: Location | null;
    attributions: Record<string, Attributions> | null;
    rdap_url: string | null;
  }

  interface Headers {
    headers: Record<string, string>;
  }

  interface IPFetchResult {
    data: IPDetail | null;
    rtt: number | null;
  }

  function measureRTT(url: string): number | null {
    const entries = performance.getEntriesByName(
      url,
      "resource",
    ) as PerformanceResourceTiming[];
    const metric = entries[entries.length - 1];

    if (!metric) return null;

    if (metric.responseStart > 0 && metric.requestStart > 0) {
      return Math.round(metric.responseStart - metric.requestStart);
    }
    return null;
  }

  async function fetchIPDetails(): Promise<Record<IPVersion, IPFetchResult>> {
    const results: Record<IPVersion, IPFetchResult> = {
      ipv4: {
        data: null,
        rtt: null,
      },
      ipv6: {
        data: null,
        rtt: null,
      },
    };

    const FETCH_URLS = {
      ipv4: `https://${window.__ENV__.IPV4_HOST}/ip/detail`,
      ipv6: `https://${window.__ENV__.IPV6_HOST}/ip/detail`,
    };

    await Promise.all(
      IP_VERSIONS.map(async (version) => {
        const url = FETCH_URLS[version];
        try {
          const res = await fetch(FETCH_URLS[version]);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);

          const data = (await res.json()) as IPDetail;
          const rtt = measureRTT(url);

          results[version] = { data, rtt };
        } catch (err) {
          console.error(`Error al obtener ${version}`, err);
        }
      }),
    );

    return results;
  }

  document.addEventListener("astro:page-load", load_all);
  async function load_all() {
    const mainIP = document.getElementById("ip-h2");
    const secondIP = document.getElementById("ip-h3");

    if (!mainIP || !secondIP) return;

    const { ipv4, ipv6 } = await fetchIPDetails();

    console.log({ ipv4, ipv6 });

    if (ipv4.data) {
      mainIP.innerText = ipv4.data.ip;
    } else if (ipv6.data) {
      mainIP.innerText = ipv6.data.ip;
    }

    if (ipv6.data && ipv4.data) {
      secondIP.innerText = ipv6.data.ip;
      secondIP.classList.remove("hidden");
    }
  }
</script>

<style>
  .header {
    border-bottom: var(--border-dashed);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h3,
  h2 {
    text-align: center;
    overflow-wrap: anywhere;
    max-width: 100%;
  }
  h3.hidden {
    display: none;
  }

  .title {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    h1 {
      white-space: nowrap;
      border: var(--border-soft);
      background: var(--surface-1);
      box-shadow: var(--shadow-label-orange);
      width: fit-content;
      padding: var(--space-1);
      position: absolute;
      top: -50px;
    }
  }
</style>
