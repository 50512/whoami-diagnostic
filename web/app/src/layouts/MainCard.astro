---
import "@50512/ui/fonts.css";
import "@50512/ui/styles.css";
---

<main>
  <div class="wrapper">
    <slot />
  </div>
</main>
<style>
  main {
    padding: var(--space-7) var(--space-5);
    max-width: 800px;
    width: 100%;
  }
  .wrapper {
    max-width: var(--content-max);
    min-height: var(--space-7);
    margin: auto auto;
    background: var(--surface-1);
    display: flex;
    flex-direction: column;

    padding: var(--space-3);
    box-shadow: var(--shadow-label-gray);

    border: var(--border-soft);
  }
</style>
