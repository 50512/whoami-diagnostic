---
import { JsonView } from "@50512/ui/json";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  title: string;
  class?: string;
  value?: unknown;
  collapse_depth?: number;
}

const { title, ...props } = Astro.props;
---

<div>
  <h2>{title}</h2>
  <JsonView {...props} />
</div>

<style>
  h2 {
    font-family: var(--font-mono);
  }
</style>
