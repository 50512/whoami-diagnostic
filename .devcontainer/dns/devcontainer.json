{
  "name": "DNS-server Dev",
  "dockerComposeFile": "../../docker-compose.yml",
  "service": "dns",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "naumovs.color-highlight",
        "oderwat.indent-rainbow",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-spanish"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
